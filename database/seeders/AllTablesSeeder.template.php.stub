<?php

namespace Database\Seeders;

use Illuminate\Database\Seeder;
use Illuminate\Support\Facades\DB;

// Copy to AllTablesSeeder.php after filling the records, then run:
// php artisan db:seed --class=AllTablesSeeder
class AllTablesSeeder extends Seeder
{
    public function run(): void
    {
        $now = now();

        // Keep this order so referenced parent records exist first.
        $recordsByTable = [
            // users: name, email, password, recovery_phrase, is_admin, remember_token
            // Hash passwords before inserting them.
            'users' => [],

            // permissions: key, label, category, description
            'permissions' => [],

            // categories: name, slug, description, user_id -> users.id
            'categories' => [],

            // locations: name, description, is_active, user_id -> users.id
            'locations' => [],

            // suppliers: name, phone, address, description, is_active
            'suppliers' => [],

            // customers: name, phone, type, user_id -> users.id
            'customers' => [],

            // products: category_id -> categories.id, user_id/updated_by -> users.id
            // Also: name, slug, sku, description, price, wholesale_price,
            // wholesale_min_qty, cost, min_stock, unit, image, is_active, lead_time
            'products' => [],

            // ledgers: product_id -> products.id, supplier_id -> suppliers.id,
            // location_id -> locations.id, customer_id -> customers.id,
            // user_id/updated_by -> users.id
            // Also: type, title, slug, amount, payment_status, due_date, description,
            // date, reference, quantity, stock_movement, proof_image
            'ledgers' => [],

            // stocks: product_id -> products.id, location_id -> locations.id,
            // user_id -> users.id; also quantity
            'stocks' => [],

            // purchase_requests: product_id -> products.id, location_id -> locations.id,
            // supplier_id -> suppliers.id, ledger_id -> ledgers.id,
            // requested_by/reviewed_by/purchased_by/received_by -> users.id
            // Also: ticket_number, requested_qty, received_qty, status, request_notes,
            // rejection_reason, reviewed_at, invoice_number, proof_image, total_cost,
            // purchased_at, received_at
            'purchase_requests' => [],

            // user_permissions: user_id -> users.id, permission_id -> permissions.id
            // Also: can_view, can_create, can_edit, can_delete
            'user_permissions' => [],
        ];

        foreach ($recordsByTable as $table => $records) {
            if ($records === []) {
                continue;
            }

            $records = array_map(
                static fn (array $record): array => $record + [
                    'created_at' => $now,
                    'updated_at' => $now,
                ],
                $records
            );

            DB::table($table)->insert($records);
        }
    }
}
